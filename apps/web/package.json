{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @sovereign/db run generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify-rbac": "tsx --env-file=.env.local scripts/verify-rbac.mts",
    "verify-audit": "tsx --env-file=.env.local scripts/verify-audit.mts",
    "verify-runner": "tsx --env-file=.env.local scripts/verify-runner.mts",
    "verify-quota": "tsx --env-file=.env.local scripts/verify-quota.mts",
    "verify-run-list": "tsx --env-file=.env.local scripts/verify-run-list.mts",
    "seed": "tsx --env-file=.env.local scripts/seed.mts",
    "measure-latency": "tsx --env-file=.env.local scripts/measure-latency.mts",
    "verify-sync-cache": "tsx --env-file=.env.local scripts/verify-sync-cache.mts",
    "verify": "pnpm run verify-ui-logic && pnpm run verify-sync-cache && pnpm run verify-approval-logic && pnpm run verify-agent-logic && pnpm run verify-safe-fetch && pnpm run verify-session && pnpm run verify-rbac && pnpm run verify-audit && pnpm run verify-quota && pnpm run verify-quota-refund && pnpm run verify-agent-step && pnpm run verify-runner && pnpm run verify-approval && pnpm run verify-run-list",
    "verify-session": "tsx --env-file=.env.local scripts/verify-session.mts",
    "dev:inngest": "cd \"$(mktemp -d)\" && npx --yes --ignore-scripts=false inngest-cli@1.49.0 dev -u http://localhost:3000/api/inngest",
    "verify-fast": "pnpm run verify-ui-logic && pnpm run verify-sync-cache && pnpm run verify-approval-logic && pnpm run verify-agent-logic && pnpm run verify-safe-fetch && pnpm run verify-session && pnpm run verify-rbac && pnpm run verify-audit && pnpm run verify-quota-refund && pnpm run verify-agent-step",
    "verify-ui-logic": "tsx --env-file=.env.local scripts/verify-ui-logic.mts",
    "verify-quota-refund": "tsx --env-file=.env.local scripts/verify-quota-refund.mts",
    "verify-approval-logic": "tsx --env-file=.env.local scripts/verify-approval-logic.mts",
    "verify-approval": "tsx --env-file=.env.local scripts/verify-approval.mts",
    "seed-demo": "tsx --env-file=.env.local scripts/seed-demo.mts",
    "verify-agent-logic": "tsx --env-file=.env.local scripts/verify-agent-logic.mts",
    "verify-safe-fetch": "tsx --env-file=.env.local scripts/verify-safe-fetch.mts",
    "verify-agent-step": "tsx --env-file=.env.local scripts/verify-agent-step.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.11",
    "@sovereign/db": "workspace:*",
    "@sovereign/shared": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "clsx": "^2.1.1",
    "inngest": "^4.22.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sovereign/config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.15.1"
}
