{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "RUNTIME_DATABASE_URL",
        "DB_SSL_CA",
        "DB_TX_MAX_WAIT_MS",
        "DB_TX_TIMEOUT_MS",
        "CLERK_SECRET_KEY",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev:inngest": {
      "cache": false,
      "persistent": true
    }
  }
}
